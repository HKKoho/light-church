# GEMINI_API_KEY: Required for Gemini AI API calls (frontend classification).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ANTHROPIC_API_KEY: Required for Claude LLM classification (Layer 2).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# CLASSIFICATION_MODEL: Claude model for transaction classification.
CLASSIFICATION_MODEL="claude-sonnet-4-6"

# CDP_PORT: Chrome DevTools Protocol port for browser session attachment (Layer 1).
CDP_PORT="9222"

# STAGING_DIR: Directory for raw extracted data staging files.
STAGING_DIR="./staging"

# REPORTS_DIR: Directory for generated Excel reports (Layer 3).
REPORTS_DIR="./reports"

# DB_PATH: Path to SQLite database file.
DB_PATH="./finance.db"

# LAYER3_PORT: Port for standalone Layer 3 reporting service.
LAYER3_PORT="3002"

# WAREHOUSE EXPORT (Layer 5)
# EXPORT_CSV_ENABLED: Enable CSV export connector.
EXPORT_CSV_ENABLED="true"

# EXPORT_JSON_DIR: Directory for JSON warehouse exports.
EXPORT_JSON_DIR="./exports/json"

# EXPORT_CSV_DIR: Directory for CSV warehouse exports.
EXPORT_CSV_DIR="./exports/csv"

# WAREHOUSE_POSTGRES_URL: PostgreSQL connection string for production warehouse.
# WAREHOUSE_POSTGRES_URL="postgresql://user:pass@host:5432/finpipeline"

# WAREHOUSE_TABLE: Target table name in PostgreSQL.
WAREHOUSE_TABLE="classified_transactions"

# WAREHOUSE_BATCH_SIZE: Records per batch during export.
WAREHOUSE_BATCH_SIZE="100"
