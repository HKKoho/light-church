{
  "rewrites": [
    {
      "source": "/api/openai/:path*",
      "destination": "/api/openai?path=:path*"
    },
    {
      "source": "/api/gemini/:path*",
      "destination": "/api/gemini?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
